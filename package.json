{
  "name": "seo-ai",
  "version": "0.7.1",
  "description": "Command-line tool to generate SEO metadata and HTML meta tags using AI models",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai",
    "seo",
    "metadata",
    "metatags"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xavimondev/seo-ai.git"
  },
  "exports": "./dist/index.js",
  "bin": "./dist/index.js",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "version:add": "changeset add",
    "version:status": "changeset status --verbose",
    "version:save": "changeset version",
    "release": "changeset publish"
  },
  "author": {
    "name": "Xavi Alfaro",
    "url": "https://x.com/xavimonp"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.11",
    "@types/node": "20.14.10",
    "prettier": "3.3.2",
    "rimraf": "6.0.1",
    "tsup": "8.3.5",
    "type-fest": "4.31.0",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "@ai-sdk/openai": "1.0.13",
    "@clack/prompts": "0.9.0",
    "ai": "4.0.27",
    "chalk": "5.4.1",
    "commander": "13.0.0",
    "conf": "13.1.0",
    "sharp": "0.33.5",
    "sharp-ico": "0.1.5",
    "zod": "3.24.1"
  },
  "engines": {
    "node": ">=20"
  }
}